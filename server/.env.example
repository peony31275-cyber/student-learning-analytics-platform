# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Pooled connection used by the running app.
#   Local (npm run db:local):  postgresql://postgres:postgres@localhost:5433/sla_dev
#   Neon: the "Pooled connection" string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sla_dev"

# Direct (non-pooled) connection used by the Prisma CLI for migrations.
#   Local: same as DATABASE_URL.  Neon: the string WITHOUT "-pooler".
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/sla_dev"

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ── HTTP ─────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
