# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────
# Keep this file pointed at the local database: db:migrate, db:seed and db:reset refuse
# anything but localhost. The Neon strings (same two keys) go in server/.env.neon and the
# Render dashboard, never here. See docs/DEPLOYMENT.md.
#
# Pooled connection used by the running app.
#   Local (npm run db:local):  postgresql://postgres:postgres@localhost:5433/sla_dev
#   Neon: the "Pooled connection" string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sla_dev"

# Direct (non-pooled) connection used by the Prisma CLI for migrations.
#   Local: same as DATABASE_URL.  Neon: the string WITHOUT "-pooler".
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/sla_dev"

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ── HTTP ─────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── Sign-in rate limit ───────────────────────────────────
# Failed attempts allowed per client IP (successful sign-ins are not counted),
# applied separately to login, registration and password change.
# Production: leave both unset to get the defaults, 20 failures per 15 minutes.
# Local development: same limit, but a lockout clears after 1 minute.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=1

# ── Student activation invites ───────────────────────────
# Base URL of the web app, used in activation links.
APP_URL=http://localhost:5173
# disabled (default): issuing invites is refused, no token is created.
# dev-link: local development only. The link is shown to the staff member who
#           creates the invite, so the flow can be tested without email.
#           The server refuses to start with dev-link when NODE_ENV=production.
INVITE_DELIVERY=dev-link
